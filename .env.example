# Generate long random values before first start. APP_PASSWORD is hashed into the database.
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8080
SPENDLOOM_PORT=8080
COOKIE_SECURE=false
TIMEZONE=Europe/London
MAX_RECEIPT_DOCUMENTS=10
MAX_RECEIPT_TOTAL_MB=100
MAX_RECEIPT_TOTAL_PAGES=20
# Match `id -u` and `id -g` on the Docker host.
PUID=1000
PGID=1000

# openai, anthropic, gemini, or codex (ChatGPT subscription through Codex CLI)
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
# Optional: use a distinct conversational model; otherwise AI_MODEL is reused.
CHAT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required only for AI_PROVIDER=codex. Keep this directory private and outside data backups.
CODEX_AUTH_DIR=./.codex-auth
CODEX_TIMEOUT_SECONDS=180

# Create the bot with @BotFather. OpenClaw is not used.
TELEGRAM_BOT_TOKEN=
# Recommended: message /id to the bot, then set your numeric Telegram ID here.
# When set, nobody else can claim or use the bot, even with a claim code.
TELEGRAM_ALLOWED_USER_ID=

# Optional Gmail receipt importer. Create a Google OAuth web client whose callback is
# APP_ORIGIN/api/integrations/gmail/oauth/callback. Keep the encryption key private
# and back it up separately; it is required to decrypt the stored refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_MINUTES=5
